  "triggers": {
    "opts": {
      "id": "triggers",
      "triggers": [
        {
          "event": "app/user.created",
          "if": "event.data.plan == 'pro'"
        },
        {
          "cron": "0 * * * *"
        },
        {
          "cron": "TZ=Europe/Paris 0 12 * * 5",
          "jitter": "30s"
        },
        {
          "event": "inngest/function.invoked"
        }
      ]
    },
    "baseUrl": "https://example.com",
    "configs": [
      {
        "id": "testclient-triggers",
        "name": "triggers",
        "triggers": [
          {
            "event": "app/user.created",
            "expression": "event.data.plan == 'pro'"
          },
          {
            "cron": "0 * * * *"
          },
          {
            "cron": "TZ=Europe/Paris 0 12 * * 5",
            "jitter": "30s"
          }
        ],
        "steps": {
          "step": {
            "id": "step",
            "name": "step",
            "runtime": {
              "type": "http",
              "url": "https://example.com/?fnId=testclient-triggers&stepId=step"
            }
          }
        }
      }
    ]
  },
