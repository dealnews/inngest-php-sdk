  "cancel_on": {
    "opts": {
      "id": "cancel",
      "triggers": [
        {
          "event": "foo"
        }
      ],
      "cancelOn": [
        {
          "event": "baz",
          "match": "data.title"
        },
        {
          "event": "qux",
          "if": "async.data.id == event.data.id"
        },
        {
          "event": "with.timeout.string",
          "timeout": "1h"
        },
        {
          "event": "with.timeout.ms",
          "timeout": 90000
        },
        {
          "event": "with.timeout.date",
          "timeout": "2030-01-02T03:04:05.000Z"
        },
        {
          "event": "match.beats.if",
          "match": "data.a",
          "if": "ignored"
        }
      ]
    },
    "baseUrl": "https://example.com",
    "configs": [
      {
        "id": "testclient-cancel",
        "name": "cancel",
        "triggers": [
          {
            "event": "foo"
          }
        ],
        "steps": {
          "step": {
            "id": "step",
            "name": "step",
            "runtime": {
              "type": "http",
              "url": "https://example.com/?fnId=testclient-cancel&stepId=step"
            }
          }
        },
        "cancel": [
          {
            "event": "baz",
            "if": "event.data.title == async.data.title"
          },
          {
            "event": "qux",
            "if": "async.data.id == event.data.id"
          },
          {
            "event": "with.timeout.string",
            "timeout": "1h"
          },
          {
            "event": "with.timeout.ms",
            "timeout": "1m30s"
          },
          {
            "event": "with.timeout.date",
            "timeout": "2030-01-02T03:04:05.000Z"
          },
          {
            "event": "match.beats.if",
            "if": "event.data.a == async.data.a"
          }
        ]
      }
    ]
  },
