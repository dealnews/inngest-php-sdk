            "runtime": {
              "type": "http",
              "url": "https://example.com/?fnId=testclient-testfn&stepId=step"
            },
            "retries": {
              "attempts": 2
            }
          }
        }
      },
      {
        "id": "testclient-testfn-failure",
        "name": "Pretty (failure)",
        "triggers": [
