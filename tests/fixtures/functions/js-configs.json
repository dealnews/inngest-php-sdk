  "flow_control": {
    "opts": {
      "id": "flow",
      "triggers": [
        {
          "event": "foo"
        }
      ],
      "concurrency": 5,
      "idempotency": "event.data.id",
      "batchEvents": {
        "maxSize": 100,
        "timeout": "5s",
        "key": "event.data.user",
        "if": "event.data.ok"
      },
      "rateLimit": {
        "key": "event.data.user",
        "limit": 10,
        "period": "1m"
      },
      "throttle": {
        "key": "event.data.user",
        "limit": 3,
        "period": "10s",
        "burst": 2
      },
      "debounce": {
        "key": "event.data.user",
        "period": "5m",
        "timeout": "1h"
      },
      "priority": {
        "run": "event.data.priority"
      },
      "timeouts": {
        "start": "10m",
        "finish": "1h"
      },
      "singleton": {
        "key": "event.data.user",
        "mode": "cancel"
      }
    },
    "baseUrl": "https://example.com",
    "configs": [
      {
        "id": "testclient-flow",
        "name": "flow",
        "triggers": [
          {
            "event": "foo"
          }
        ],
        "steps": {
          "step": {
            "id": "step",
            "name": "step",
            "runtime": {
              "type": "http",
              "url": "https://example.com/?fnId=testclient-flow&stepId=step"
            }
          }
        },
        "idempotency": "event.data.id",
        "batchEvents": {
          "maxSize": 100,
          "timeout": "5s",
          "key": "event.data.user",
          "if": "event.data.ok"
        },
        "rateLimit": {
          "key": "event.data.user",
          "limit": 10,
          "period": "1m"
        },
        "throttle": {
          "key": "event.data.user",
          "limit": 3,
          "period": "10s",
          "burst": 2
        },
        "concurrency": 5,
        "debounce": {
          "key": "event.data.user",
          "period": "5m",
          "timeout": "1h"
        },
        "priority": {
          "run": "event.data.priority"
        },
        "timeouts": {
          "start": "10m",
          "finish": "1h"
        },
        "singleton": {
          "key": "event.data.user",
          "mode": "cancel"
        }
      }
    ]
  },
