{
    "name": "dealnews/inngest-php-sdk",
    "description": "Unofficial PHP SDK for Inngest - Build event-driven workflows with durable execution",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": ["inngest", "event-driven", "workflow", "serverless", "queue", "background-jobs"],
    "authors": [
        {
            "name": "Brian Moon",
            "email": "brianm@dealnews.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-hash": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^8.3",
        "moonspot/value-objects": "^2.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "DealNews\\Inngest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DealNews\\Inngest\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "parallel-lint src/ tests/",
            "phpunit --colors=never"
        ],
        "lint": [
            "parallel-lint src/ tests/"
        ],
        "fix": [
            "php-cs-fixer fix --config .php-cs-fixer.dist.php src tests"
        ]
    }
}
